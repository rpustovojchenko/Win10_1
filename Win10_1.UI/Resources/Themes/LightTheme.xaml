<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="App.Background"
                     Color="#E9EDF2" />

    <SolidColorBrush x:Key="App.CardBackground"
                     Color="#F8FAFC" />

    <SolidColorBrush x:Key="App.CardBorder"
                     Color="#B8C2CF" />

    <SolidColorBrush x:Key="App.TextPrimary"
                     Color="#1C2733" />

    <SolidColorBrush x:Key="App.TextSecondary"
                     Color="#4D5B6B" />

    <SolidColorBrush x:Key="App.Accent"
                     Color="#0969DA" />

    <SolidColorBrush x:Key="App.AccentText"
                     Color="#FFFFFF" />

    <SolidColorBrush x:Key="App.ControlBackground"
                     Color="#FFFFFF" />

    <SolidColorBrush x:Key="App.ControlBorder"
                     Color="#8C9AAA" />

    <SolidColorBrush x:Key="App.Danger"
                     Color="#C62828" />

    <SolidColorBrush x:Key="App.Success"
                     Color="#218739" />

</ResourceDictionary>