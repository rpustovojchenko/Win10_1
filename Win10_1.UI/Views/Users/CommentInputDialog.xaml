<UserControl x:Class="Win10_1.UI.Views.Users.CommentInputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Strings.Author}"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource App.TextSecondary}" />

            <TextBlock Text="{Binding Author}"
                       Foreground="{DynamicResource App.TextPrimary}"
                       Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{DynamicResource Strings.Comment}"
                   Margin="0,8,0,4"
                   Foreground="{DynamicResource App.TextSecondary}" />

        <TextBox Grid.Row="3"
                 Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="60"
                 MaxHeight="120"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="4"
                   Text="{Binding CommentError}"
                   Foreground="{DynamicResource App.Danger}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="{Binding ConfirmBtnText}"
                    Padding="16,4"
                    Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}" />
            <Button Content="{DynamicResource Strings.Cancel}"
                    Padding="16,4"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>