<UserControl x:Class="Win10_1.UI.Views.Users.Logo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel Orientation="Vertical">

        <Viewbox Width="{Binding ViewBoxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Height="{Binding ViewBoxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="0, 0, 0, 20">
            <iconPacks:PackIconMaterialDesign Kind="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Viewbox>

        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
