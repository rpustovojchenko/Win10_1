<UserControl x:Class="Win10_1.UI.Views.Users.ProjectInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:converter="clr-namespace:Win10_1.UI.Converters"
             xmlns:enums="clr-namespace:Win10_1.Domain.Enums;assembly=Win10_1.Domain"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <converter:NullableDateToStringConverter    x:Key="DateConverter" />
        <converter:NullableThemeToStringConverter   x:Key="ThemeConverter" />
        <converter:UtcDateToLocalStringConverter    x:Key="UtcDateConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource App.CardBackground}"
            BorderBrush="{DynamicResource App.CardBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,0,0,8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ProjectName}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimary}"
                           Margin="0,0,8,6"
                           TextWrapping="Wrap"
                           TextTrimming="None" />

                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource Strings.EditProject}"
                        Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <iconPacks:PackIconMaterial Kind="Pencil"
                                                Width="18"
                                                Height="18"
                                                Foreground="{DynamicResource App.TextPrimary}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Strings.ThemeName}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Theme, Converter={StaticResource ThemeConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>

                <DockPanel Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,6,6">
                    <TextBlock Text="{DynamicResource Strings.Readiness}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ProgressBar Value="{Binding PercentComplete}"
                                     Maximum="100"
                                     Height="10"
                                     Width="120"
                                     Margin="0,0,4,0"
                                     Background="{DynamicResource App.ControlBackground}"
                                     Foreground="{DynamicResource App.Accent}" />
                        <TextBlock Text="{Binding PercentComplete, StringFormat={}{0}%}"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="1"
                           Grid.Column="1"
                           Margin="6,0,0,6">
                    <TextBlock Text="{DynamicResource Strings.Priority}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Foreground="{DynamicResource App.TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="{x:Static enums:Priority.None}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityNone}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="{x:Static enums:Priority.Low}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityLow}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="{x:Static enums:Priority.Medium}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityMedium}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="{x:Static enums:Priority.High}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityHigh}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="{x:Static enums:Priority.Critical}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityCritical}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <DockPanel Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,6,6">
                    <TextBlock Text="{DynamicResource Strings.Status}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Foreground="{DynamicResource App.TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{DynamicResource Strings.StatusNone}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:Status.NonStarted}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusNonStarted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:Status.InProgress}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusInProgress}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:Status.OnHold}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusOnHold}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:Status.Completed}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCompleted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:Status.Cancelled}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCancelled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <DockPanel Grid.Row="2"
                           Grid.Column="1"
                           Margin="6,0,0,6">
                    <TextBlock Text="{DynamicResource Strings.Deadline}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DeadLine, Converter={StaticResource DateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>

                <DockPanel Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,0,6,6">
                    <TextBlock Text="{DynamicResource Strings.CreatedAt}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcDateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>

                <DockPanel Grid.Row="3"
                           Grid.Column="1"
                           Margin="6,0,0,6">
                    <TextBlock Text="{DynamicResource Strings.UpdatedAt}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource UtcDateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>

                <DockPanel Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,0">
                    <TextBlock Text="{DynamicResource Strings.Description}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource App.TextPrimary}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>