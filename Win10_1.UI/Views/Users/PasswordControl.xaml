<UserControl x:Class="Win10_1.UI.Views.Users.PasswordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:enums="clr-namespace:Win10_1.Domain.Enums;assembly=Win10_1.Domain"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel Orientation="Vertical">

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="{Binding LabelMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Padding="{Binding LabelPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource App.TextPrimary}" />

        <PasswordBox x:Name="PasswordBoxInput"
                     PasswordChanged="OnPasswordChanged"
                     mah:TextBoxHelper.Watermark="{Binding WatermarkText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Margin="{Binding TextBoxMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Padding="{Binding TextBoxPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     mah:ControlsHelper.CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <ItemsControl Margin="10,0,0,5">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource App.TextSecondary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="Confirmation">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="None">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>

            <ItemsControl.Items>
                <TextBlock Text="{DynamicResource Strings.PasswordLatinOnly}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LatinState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Passed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Success}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LatinState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Failed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{DynamicResource Strings.PasswordMinLength}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LengthState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Passed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Success}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LengthState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Failed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{DynamicResource Strings.PasswordDigitOrSpecial}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecialState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Passed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Success}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SpecialState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="{x:Static enums:PasswordRequirementState.Failed}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource App.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </ItemsControl.Items>
        </ItemsControl>

        <TextBlock Text="{DynamicResource Strings.PasswordsMustMatch}"
                   Margin="10,0,0,5">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource App.TextSecondary}" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="Confirmation">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ConfirmState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static enums:PasswordRequirementState.Passed}">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.Success}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ConfirmState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static enums:PasswordRequirementState.Failed}">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.Danger}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ConfirmState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Static enums:PasswordRequirementState.NotChecked}">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource App.TextSecondary}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </StackPanel>
</UserControl>