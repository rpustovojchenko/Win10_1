<UserControl x:Class="Win10_1.UI.Views.Users.TaskItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:converter="clr-namespace:Win10_1.UI.Converters"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="450">

    <UserControl.Resources>
        <converter:UtcDateToLocalStringConverter x:Key="UtcDateConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource App.CardBackground}"
            BorderBrush="{DynamicResource App.CardBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Название задачи -->
            <TextBlock Grid.Row="0"
                       Text="{Binding TaskTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextPrimary}"
                       Margin="0,0,0,6" />

            <!-- Описание задачи -->
            <TextBlock Grid.Row="1"
                       Text="{Binding TaskDescription, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource App.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- Дата и кнопки -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding UpdatedAt, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource UtcDateConverter}}"
                           FontSize="11"
                           Foreground="{DynamicResource App.TextMuted}"
                           VerticalAlignment="Bottom" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                    <Button Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"
                            ToolTip="{DynamicResource Strings.Edit}"
                            Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding EditCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource App.TextPrimary}" />
                    </Button>

                    <Button Width="28"
                            Height="28"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"
                            ToolTip="{DynamicResource Strings.Delete}"
                            Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding DeleteCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <iconPacks:PackIconMaterial Kind="Delete"
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource App.Danger}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>