<UserControl x:Class="Win10_1.UI.Views.Users.ProjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:converter="clr-namespace:Win10_1.UI.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:enums="clr-namespace:Win10_1.Domain.Enums;assembly=Win10_1.Domain"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             MaxWidth="580"
             MinWidth="400"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <converter:NullableDateToStringConverter    x:Key="DateConverter" />
        <converter:NullableThemeToStringConverter   x:Key="ThemeConverter" />
        <converter:UtcDateToLocalStringConverter    x:Key="UtcDateConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource App.CardBackground}"
            BorderBrush="{DynamicResource App.CardBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="2"
            HorizontalAlignment="Stretch">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Название проекта -->
                <Border Background="{DynamicResource App.Accent}"
                        BorderBrush="{DynamicResource App.AccentBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,3"
                        Margin="0,0,4,0">
                    <TextBlock Text="{Binding ProjectName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource App.AccentText}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="40" />
                </Border>

                <!-- Кнопки редактировать/удалить -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Width="24"
                            Height="24"
                            Margin="0,0,4,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{DynamicResource Strings.EditProject}"
                            Command="{Binding DataContext.EditProjectCommand, 
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource App.TextPrimary}" />
                    </Button>

                    <Button Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{DynamicResource Strings.DeleteProject}"
                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <iconPacks:PackIconMaterial Kind="Delete"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource App.TextPrimary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Тема -->
            <DockPanel Grid.Row="1"
                       Margin="0,6,0,4">
                <TextBlock Text="{DynamicResource Strings.ThemeName}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource App.TextSecondary}"
                           DockPanel.Dock="Left"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding Theme, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeConverter}}"
                           Foreground="{DynamicResource App.TextPrimary}"
                           TextWrapping="Wrap" />
            </DockPanel>

            <!-- Готовность + Приоритет -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.Readiness}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Value="{Binding PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Maximum="100"
                                     Height="10"
                                     Width="90"
                                     Margin="0,2,4,0"
                                     Background="{DynamicResource App.ControlBackground}"
                                     Foreground="{DynamicResource App.Accent}" />
                        <TextBlock Text="{Binding PercentComplete, StringFormat={}{0}%, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Strings.Priority}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <TextBlock Foreground="{DynamicResource App.TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{DynamicResource Strings.PriorityNone}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Priority.Low}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityLow}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Priority.Medium}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityMedium}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Priority.High}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityHigh}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Priority.Critical}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.PriorityCritical}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>

            <!-- Статус + Дедлайн -->
            <Grid Grid.Row="3"
                  Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.Status}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <TextBlock Foreground="{DynamicResource App.TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{DynamicResource Strings.StatusNone}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Status.NonStarted}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusNonStarted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Status.InProgress}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusInProgress}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Status.OnHold}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusOnHold}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Status.Completed}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCompleted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{x:Static enums:Status.Cancelled}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCancelled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Strings.Deadline}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DeadLine, 
                                              RelativeSource={RelativeSource AncestorType=UserControl}, 
                                              Converter={StaticResource DateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>
            </Grid>

            <!-- Создан + Изменён -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.CreatedAt}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CreatedAt, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource UtcDateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Strings.UpdatedAt}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource App.TextSecondary}"
                               DockPanel.Dock="Left"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding UpdatedAt, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource UtcDateConverter}}"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>