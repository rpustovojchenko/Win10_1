<UserControl x:Class="Win10_1.UI.Views.Users.ProjectEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:user="clr-namespace:Win10_1.UI.Views.Users"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,12">

                <!-- Название проекта -->
                <user:TextBlockControl LabelText="{DynamicResource Strings.ProjectName}"
                                       Text="{Binding ProjectName}"
                                       WatermarkText="{DynamicResource Strings.EnterProjectName}"
                                       TextBoxMargin="0,5,0,2"
                                       TextBoxPadding="5"
                                       CornerRadius="8"
                                       TextWrapping="Wrap" />

                <TextBlock Text="{Binding ProjectNameError}"
                           Foreground="{DynamicResource App.Danger}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Тема -->
                <user:TextBlockControl LabelText="{DynamicResource Strings.ThemeName}"
                                       Text="{Binding Theme}"
                                       WatermarkText="{DynamicResource Strings.EnterThemeName}"
                                       TextBoxMargin="0,5,0,2"
                                       TextBoxPadding="5"
                                       CornerRadius="8"
                                       TextWrapping="Wrap" />

                <TextBlock Text="{Binding ThemeError}"
                           Foreground="{DynamicResource App.Danger}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Описание проекта -->
                <user:TextBlockControl LabelText="{DynamicResource Strings.Description}"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       AcceptsReturn="True"
                                       WatermarkText="{DynamicResource Strings.EnterProjectDescription}"
                                       TextBoxMargin="0,5,0,2"
                                       TextBoxPadding="5"
                                       CornerRadius="8" />

                <TextBlock Text="{Binding DescriptionError}"
                           Foreground="{DynamicResource App.Danger}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Дедлайн / процент / статус / приоритет -->
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Дедлайн -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="4"
                                HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Strings.Deadline}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimary}"
                                   Margin="0,0,0,3" />
                        <DatePicker SelectedDate="{Binding DeadLine}"
                                    Style="{DynamicResource MahApps.Styles.DatePicker}"
                                    mah:TextBoxHelper.Watermark="{DynamicResource Strings.SelectDate}"
                                    Width="150"
                                    Height="35"
                                    HorizontalAlignment="Left">
                            <DatePicker.Resources>
                                <Style TargetType="{x:Type DatePickerTextBox}"
                                       BasedOn="{StaticResource MahApps.Styles.DatePickerTextBox}">
                                    <Setter Property="IsReadOnly"
                                            Value="True" />
                                    <Setter Property="BorderThickness"
                                            Value="0" />
                                    <Setter Property="Padding"
                                            Value="4,3,4,3" />
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>

                    <!-- Процент выполнения -->
                    <user:PercentageControl Grid.Row="0"
                                            Grid.Column="1"
                                            LabelText="{DynamicResource Strings.PercentComplete}"
                                            Percent="{Binding PercentComplete}"
                                            HorizontalAlignment="Right" />

                    <!-- Статус -->
                    <user:StatusControl Grid.Row="1"
                                        Grid.Column="0"
                                        LabelText="{DynamicResource Strings.Status}"
                                        Status="{Binding Status}"
                                        HorizontalAlignment="Left" />

                    <!-- Приоритет -->
                    <user:PriorityControl Grid.Row="1"
                                          Grid.Column="1"
                                          LabelText="{DynamicResource Strings.Priority}"
                                          Priority="{Binding Priority}"
                                          HorizontalAlignment="Right" />
                </Grid>

                <ProgressBar Value="{Binding PercentComplete}"
                             Margin="0,20,0,0"
                             Foreground="{DynamicResource App.Accent}"
                             Background="{DynamicResource App.ControlBackground}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <Button Content="{DynamicResource Strings.Save}"
                    Padding="16,4"
                    Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}" />
            <Button Content="{DynamicResource Strings.Cancel}"
                    Padding="16,4"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>