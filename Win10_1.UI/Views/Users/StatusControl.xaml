<UserControl x:Class="Win10_1.UI.Views.Users.StatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:Win10_1.Domain.Enums;assembly=Win10_1.Domain"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <StackPanel Orientation="Vertical"
                Margin="4">
        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,3" />

        <ComboBox SelectedItem="{Binding Status,
                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                         Mode=TwoWay}"
                  Width="150"
                  Height="35"
                  HorizontalAlignment="Left">
            <ComboBox.ItemsSource>
                <x:Array Type="enums:Status">
                    <enums:Status>None</enums:Status>
                    <enums:Status>NonStarted</enums:Status>
                    <enums:Status>InProgress</enums:Status>
                    <enums:Status>OnHold</enums:Status>
                    <enums:Status>Completed</enums:Status>
                    <enums:Status>Cancelled</enums:Status>
                </x:Array>
            </ComboBox.ItemsSource>

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{Binding}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.None}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusNone}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.NonStarted}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusNonStarted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.InProgress}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusInProgress}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.OnHold}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusOnHold}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.Completed}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCompleted}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}"
                                                 Value="{x:Static enums:Status.Cancelled}">
                                        <Setter Property="Text"
                                                Value="{DynamicResource Strings.StatusCancelled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>