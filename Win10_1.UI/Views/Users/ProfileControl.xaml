<UserControl x:Class="Win10_1.UI.Views.Users.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Win10_1.UI.Views.Users"
             xmlns:mah="clr-namespace:MahApps.Metro.Behaviors;assembly=MahApps.Metro"
             xmlns:dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             dialog:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="500"
             HorizontalAlignment="Stretch">

    <Border Background="{DynamicResource App.CardBackground}"
            BorderBrush="{DynamicResource App.CardBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18"
            Margin="12"
            MinWidth="450"
            MaxWidth="580">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Strings.Profile}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextPrimary}"
                       Margin="0,0,0,18" />

            <!-- Текущее имя -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Strings.Username}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding User.Username}"
                           Foreground="{DynamicResource App.TextPrimary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Текущий логин -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Strings.Login}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding User.Login}"
                           Foreground="{DynamicResource App.TextPrimary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>

            <Separator Grid.Row="3"
                       Margin="0,0,0,16" />

            <!-- Поля изменения -->
            <StackPanel Grid.Row="4">

                <TextBlock Text="{DynamicResource Strings.NewUsername}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding NewUsername,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource Strings.NewLogin}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding NewLogin,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource Strings.NewPassword}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           Margin="0,0,0,4" />

                <PasswordBox mah:PasswordBoxBindingBehavior.Password="{Binding NewPassword,
                                                                               Mode=TwoWay,
                                                                               UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource Strings.ConfirmPassword}"
                           Foreground="{DynamicResource App.TextSecondary}"
                           Margin="0,0,0,4" />

                <PasswordBox mah:PasswordBoxBindingBehavior.Password="{Binding ConfirmPassword,
                                                                               Mode=TwoWay,
                                                                               UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />
            </StackPanel>

            <Button Grid.Row="5"
                    Content="{DynamicResource Strings.SaveChanges}"
                    HorizontalAlignment="Right"
                    Padding="16,6"
                    Command="{Binding SaveProfileCommand}" />
        </Grid>
    </Border>
</UserControl>