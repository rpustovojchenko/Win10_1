<mah:MetroWindow x:Class="Win10_1.UI.Views.Windows.AuthorizationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:local="clr-namespace:Win10_1.UI.Views.Windows"
                 mc:Ignorable="d"
                 xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                 dialogs:DialogParticipation.Register="{Binding}"
                 xmlns:user="clr-namespace:Win10_1.UI.Views.Users"
                 Title="Авторизация"
                 Height="650"
                 Width="450"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen">

    <DockPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Войти">
                <TabItem.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding SignInCommand}" />
                </TabItem.InputBindings>

                <StackPanel Margin="40"
                            VerticalAlignment="Center">

                    <user:Logo ViewBoxWidth="80"
                               ViewBoxHeight="80"
                               Kind="TaskRound"
                               Text="Войти в TaskManager"
                               Foreground="{DynamicResource App.TextPrimary}"
                               Margin="0,20,0,20"
                               HorizontalAlignment="Center" />

                    <user:TextBlockControl LabelText="Логин"
                                           Text="{Binding User.Login}"
                                           WatermarkText="Введите логин"
                                           TextBoxMargin="0,5,0,10"
                                           TextBoxPadding="5"
                                           CornerRadius="8" />

                    <user:PasswordControl LabelText="Пароль"
                                          Password="{Binding Password.Password}"
                                          Mode="None"
                                          WatermarkText="Введите пароль"
                                          TextBoxMargin="0,5,0,0"
                                          TextBoxPadding="5"
                                          CornerRadius="8" />

                    <Button Content="Войти"
                            Command="{Binding SignInCommand}"
                            Margin="30"
                            mah:ControlsHelper.CornerRadius="8" />

                </StackPanel>
            </TabItem>

            <TabItem Header="Зарегистрироваться">
                <TabItem.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding SignUpCommand}" />
                </TabItem.InputBindings>

                <StackPanel Margin="40"
                            VerticalAlignment="Center">

                    <user:Logo ViewBoxWidth="80"
                               ViewBoxHeight="80"
                               Kind="TaskRound"
                               Text="Зарегистрироваться в TaskManager"
                               Foreground="{DynamicResource App.TextPrimary}"
                               Margin="0,20,0,20"
                               HorizontalAlignment="Center" />

                    <user:TextBlockControl LabelText="Имя"
                                           Text="{Binding User.Username}"
                                           WatermarkText="Введите имя"
                                           TextBoxMargin="0,5,0,10"
                                           TextBoxPadding="5"
                                           CornerRadius="8" />

                    <user:TextBlockControl LabelText="Логин"
                                           Text="{Binding User.Login}"
                                           WatermarkText="Введите логин"
                                           TextBoxMargin="0,5,0,10"
                                           TextBoxPadding="5"
                                           CornerRadius="8" />

                    <user:PasswordControl LabelText="Пароль"
                                          Password="{Binding Password.Password}"
                                          WatermarkText="Введите пароль"
                                          Mode="Main"
                                          LatinState="{Binding Password.LatinState}"
                                          LengthState="{Binding Password.LengthState}"
                                          SpecialState="{Binding Password.SpecialState}"
                                          TextBoxMargin="0,5,0,0"
                                          TextBoxPadding="5"
                                          CornerRadius="8" />

                    <user:PasswordControl LabelText="Подтвердите пароль"
                                          Password="{Binding Password.ConfirmPassword}"
                                          Mode="Confirmation"
                                          ConfirmState="{Binding Password.ConfirmState}"
                                          WatermarkText="Введите пароль"
                                          TextBoxMargin="0,5,0,0"
                                          TextBoxPadding="5"
                                          CornerRadius="8" />

                    <Button Content="Зарегистрироваться"
                            Command="{Binding SignUpCommand}"
                            Margin="30"
                            mah:ControlsHelper.CornerRadius="8" />

                </StackPanel>
            </TabItem>

        </TabControl>

    </DockPanel>
</mah:MetroWindow>