<mah:MetroWindow x:Class="Win10_1.UI.Views.Windows.TaskManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Win10_1.UI.Views.Windows"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:converter="clr-namespace:Win10_1.UI.Converters"
                 mc:Ignorable="d"
                 xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                 dialogs:DialogParticipation.Register="{Binding}"
                 xmlns:user="clr-namespace:Win10_1.UI.Views.Users"
                 Title="{DynamicResource Strings.AppTitle}"
                 Height="550"
                 Width="800"
                 WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <converter:BoolToVisibilityConverter        x:Key="VisibilityConverter" />
        <converter:NullableDateToStringConverter    x:Key="DateConverter" />
        <converter:NullableThemeToStringConverter   x:Key="ThemeConverter" />
        <converter:UtcDateToLocalStringConverter    x:Key="UtcDateConverter" />
    </mah:MetroWindow.Resources>

    <Grid>
        <TabControl SelectedIndex="{Binding TabControlIndex}">

            <!-- Проекты -->
            <TabItem Header="{DynamicResource Strings.Projects}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <!-- Панель фильтров -->
                        <Border Margin="8,48,8,8"
                                Background="{DynamicResource App.CardBackground}"
                                BorderBrush="{DynamicResource App.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Visibility="{Binding IsChecked, ElementName=FiltersToggleButton, Converter={StaticResource VisibilityConverter}}">
                            <StackPanel>

                                <!-- Фильтр по названию -->
                                <user:TextBlockControl LabelText="{DynamicResource Strings.FilterByProjectName}"
                                                       Text="{Binding Filters.ProjectNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                                       Margin="0,0,0,8" />

                                <!-- Фильтр по теме -->
                                <user:TextBlockControl LabelText="{DynamicResource Strings.FilterByTheme}"
                                                       Text="{Binding Filters.ThemeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                       Margin="0,0,0,8" />

                                <!-- Фильтр по статусу -->
                                <user:StatusControl LabelText="{DynamicResource Strings.FilterByStatus}"
                                                    Status="{Binding Filters.StatusFilter}"
                                                    Margin="0,0,0,8" />

                                <!-- Фильтр по приоритету -->
                                <user:PriorityControl LabelText="{DynamicResource Strings.FilterByPriority}"
                                                      Priority="{Binding Filters.PriorityFilter}"
                                                      Margin="0,0,0,8" />

                                <Button Content="{DynamicResource Strings.Reset}"
                                        Command="{Binding ResetCommand}"
                                        Margin="0,12,0,8" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="FiltersToggleButton"
                                      Width="32"
                                      Height="32"
                                      Margin="8"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Content="☰" />
                    </Grid>

                    <!-- Список проектов -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Center">
                        <ListBox ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch"
                                 Margin="20"
                                 MinHeight="100"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                    <Setter Property="Width"
                                            Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <user:ProjectControl ProjectName="{Binding ProjectName}"
                                                         Theme="{Binding Theme}"
                                                         PercentComplete="{Binding PercentComplete}"
                                                         Priority="{Binding Priority}"
                                                         Status="{Binding Status}"
                                                         DeadLine="{Binding DeadLine}"
                                                         CreatedAt="{Binding CreatedAt}"
                                                         UpdatedAt="{Binding UpdatedAt}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Проект -->
            <TabItem Header="{DynamicResource Strings.Project}"
                     Visibility="{Binding IsProjectTabItemVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="0,0,0,8">

                            <!-- Информация о проекте -->
                            <TextBlock Text="{DynamicResource Strings.Information}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       Margin="0,0,0,4" />

                            <user:ProjectInfoControl DataContext="{Binding SelectedProject}" />

                            <!-- Задачи -->
                            <TextBlock Text="{DynamicResource Strings.Tasks}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding IsTasksVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Background="{DynamicResource App.CardBackground}"
                                    BorderBrush="{DynamicResource App.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding IsTasksVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl x:Name="TasksItemsControl"
                                              ItemsSource="{Binding SelectedProject.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <user:TaskItemControl TaskTitle="{Binding Title}"
                                                                  TaskDescription="{Binding Description}"
                                                                  UpdatedAt="{Binding UpdatedAt}"
                                                                  EditCommand="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  EditCommandParameter="{Binding .}"
                                                                  DeleteCommand="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  DeleteCommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Комментарии -->
                            <TextBlock Text="{DynamicResource Strings.Comments}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding IsCommentsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Background="{DynamicResource App.CardBackground}"
                                    BorderBrush="{DynamicResource App.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    Margin="0,0,0,0"
                                    Visibility="{Binding IsCommentsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl x:Name="CommentsItemsControl"
                                              ItemsSource="{Binding SelectedProject.Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <user:CommentItemControl Author="{Binding Author}"
                                                                     Comment="{Binding Comment}"
                                                                     UpdatedAt="{Binding UpdatedAt}"
                                                                     EditCommand="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     EditCommandParameter="{Binding .}"
                                                                     DeleteCommand="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     DeleteCommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки добавить задачу/комментарий -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.CardBorder}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8"
                            Padding="8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="{DynamicResource Strings.AddTask}"
                                    Padding="16,4"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddTaskCommand}" />

                            <Button Content="{DynamicResource Strings.AddComment}"
                                    Padding="16,4"
                                    Command="{Binding AddCommentCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Новый проект -->
            <TabItem Header="{DynamicResource Strings.NewProject}">
                <ScrollViewer HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">

                    <user:ProjectCreateControl Project="{Binding Project}"
                                               AddProjectCommand="{Binding AddProjectCommand}" />
                </ScrollViewer>
            </TabItem>

            <!-- Настройки -->
            <TabItem Header="{DynamicResource Strings.Settings}">
                <Grid>
                    <user:SettingsControl DataContext="{Binding Settings}" 
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- Профиль пользователя -->
            <TabItem Header="{Binding User.Login}">
                <Grid>
                    <user:ProfileControl DataContext="{Binding Profile}" 
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</mah:MetroWindow>